  }
  function setRunningControls(running){
    $("#btn-start").disabled=running;$("#btn-stop").disabled=!running;
  }
  async function runByok(){
    var cfg;try{cfg=readCfg("#cfgA");}catch(e){statusEl.textContent=e.message;return;}
    persistKeys();var myGame=beginGame();reset();busy=true;setRunningControls(true);
    try{
      while(isActive(myGame)&&!over){
        var mv=await llmTurn(cfg,BLACK,"你的 AI",myGame);
        if(mv.forfeit){endGame(WHITE);break;}
        if(!isActive(myGame))break;
        if(place(mv.j,BLACK))break;
        await sleep(350,activeAbort&&activeAbort.signal);
        if(!isActive(myGame))break;
        var m=bestMoveFor(board,WHITE);
        if(place(m,WHITE))break;
        log("擂主落子 "+coordName(m));
      }
    }catch(e){if(String(e.message).indexOf("__abort")<0){statusEl.textContent=e.message;log(escapeHtml(e.message),"ar-li-warn");}}
    if(isActive(myGame)){busy=false;setRunningControls(false);}
  }
  async function runWatch(){
    var cfgA,cfgB;
    try{cfgA=readCfg("#cfgA");cfgB=readCfg("#cfgB");}catch(e){statusEl.textContent=e.message;return;}
    persistKeys();var myGame=beginGame();reset();busy=true;setRunningControls(true);
    try{
      while(isActive(myGame)&&!over){
        var mvA=await llmTurn(cfgA,BLACK,"黑方 AI",myGame);
        if(mvA.forfeit){endGame(WHITE);break;}
        if(!isActive(myGame))break;
        if(place(mvA.j,BLACK))break;
        await sleep(400,activeAbort&&activeAbort.signal);
        if(!isActive(myGame))break;
        var mvB=await llmTurn(cfgB,WHITE,"白方 AI",myGame);
        if(mvB.forfeit){endGame(BLACK);break;}
        if(!isActive(myGame))break;
        if(place(mvB.j,WHITE))break;
        await sleep(400,activeAbort&&activeAbort.signal);
      }
    }catch(e){if(String(e.message).indexOf("__abort")<0){statusEl.textContent=e.message;log(escapeHtml(e.message),"ar-li-warn");}}
    if(isActive(myGame)){busy=false;setRunningControls(false);}
  }
  function sleep(ms,signal){return new Promise(function(res,rej){
    if(signal&&signal.aborted){rej(new Error("__abort"));return;}
    var t=setTimeout(res,ms);
    if(signal)signal.addEventListener("abort",function(){clearTimeout(t);rej(new Error("__abort"));},{once:true});
  })}

  // ===== 战报卡 =====
  function drawCard(){
    var cv=$("#cardCanvas"),x=cv.getContext("2d");
    x.fillStyle="#101014";x.fillRect(0,0,1080,1440);
    var g=x.createLinearGradient(0,0,1080,0);g.addColorStop(0,"#ea580c");g.addColorStop(1,"#f59e0b");
    x.fillStyle=g;x.fillRect(0,0,1080,14);
    var title=(lastOutcome&&lastOutcome.title)||cardTitle("draw");
    x.fillStyle="#f59e0b";x.font="bold 38px sans-serif";x.fillText("AI 擂台 · 五子棋战报",60,90);
    x.fillStyle="#fff";x.font="bold 64px sans-serif";
    wrapText(x,title,60,165,960,70,2);
    x.fillStyle="#a1a1aa";x.font="32px sans-serif";
    x.fillText("共 "+moves.length+" 手 · "+modeLabel()+" · 难度:"+difficultyLabel()+" · 犯规:"+foulEvents.length+" 次",60,300);
    // board
    var bx=90,by=360,cell=56;
    x.fillStyle="#d9b06b";x.fillRect(bx-30,by-30,cell*14+60,cell*14+60);
    x.strokeStyle="#7c5a26";x.lineWidth=2;
    for(var i=0;i<15;i++){
      x.beginPath();x.moveTo(bx,by+i*cell);x.lineTo(bx+14*cell,by+i*cell);x.stroke();
      x.beginPath();x.moveTo(bx+i*cell,by);x.lineTo(bx+i*cell,by+14*cell);x.stroke();
    }
    for(var k=0;k<moves.length;k++){
      var mv=moves[k],r=(mv.j/15)|0,c=mv.j%15;
      x.beginPath();x.arc(bx+c*cell,by+r*cell,24,0,7);
      x.fillStyle=mv.who===BLACK?"#111":"#fafafa";x.fill();
      x.strokeStyle="#333";x.lineWidth=1.5;x.stroke();
      if(k===moves.length-1){x.strokeStyle="#ef4444";x.lineWidth=4;x.beginPath();x.arc(bx+c*cell,by+r*cell,28,0,7);x.stroke();}
    }
    var reason=bestReasonText();
    x.fillStyle="#27272a";roundRect(x,60,1215,960,94,14);x.fill();
    x.fillStyle="#fef3c7";x.font="bold 28px sans-serif";x.fillText(reason.title,86,1252);
    x.fillStyle="#fff";x.font="28px sans-serif";wrapText(x,reason.text,86,1290,900,36,2);
    x.fillStyle="#71717a";x.font="28px sans-serif";
    x.fillText("黑 = 挑战方 · 白 = "+(mode==="watch"?"白方 AI":"擂主(规则引擎)")+" · "+new Date().toLocaleDateString(),60,1350);
    x.fillStyle="#f59e0b";x.font="bold 34px sans-serif";
    x.fillText("来挑战:sanmoshice.com/arena",60,1400);
    var a=document.createElement("a");a.download="arena-"+Date.now()+".png";a.href=cv.toDataURL("image/png");a.click();
  }
  function roundRect(x,left,top,width,height,radius){
    x.beginPath();x.moveTo(left+radius,top);x.lineTo(left+width-radius,top);x.quadraticCurveTo(left+width,top,left+width,top+radius);x.lineTo(left+width,top+height-radius);x.quadraticCurveTo(left+width,top+height,left+width-radius,top+height);x.lineTo(left+radius,top+height);x.quadraticCurveTo(left,top+height,left,top+height-radius);x.lineTo(left,top+radius);x.quadraticCurveTo(left,top,left+radius,top);x.closePath();
  }
  function wrapText(x,text,left,top,maxWidth,lineHeight,maxLines){
    var words=String(text||"").split(""),line="",lines=0,i,test;
    for(i=0;i<words.length;i++){
      test=line+words[i];
      if(x.measureText(test).width>maxWidth&&line){x.fillText(line,left,top);top+=lineHeight;lines++;line=words[i];if(maxLines&&lines>=maxLines-1)break;}
      else line=test;
    }
    if(maxLines&&lines>=maxLines-1&&i<words.length-1)line=line.slice(0,Math.max(0,line.length-1))+"…";
    if(line)x.fillText(line,left,top);
  }
  function challengeName(){
    if(mode==="human")return "我";
    if(MOCK_MODE)return "模拟 AI";
    var model=($("#cfgA")&&$("#cfgA").querySelector(".ai-model").value.trim())||"我的 AI";
    return "我的 "+model;
  }
  function modeLabel(){return mode==="human"?"真人挑战":mode==="byok"?(MOCK_MODE?"模拟 AI 代打":"AI 代打"):"AI 对战"}
  function cardTitle(result){
    var name=challengeName();
    if(result==="challenger")return name+" 击败了擂主";
    if(result==="host")return name+" 被 300 行 if-else 教育了";
    return name+" 和擂主打成了平手";
  }
  function bestReasonText(){
    if(foulEvents.length)return {title:"AI 犯规名场面",text:foulEvents[foulEvents.length-1].label+" "+foulEvents[foulEvents.length-1].error};
    if(aiReasons.length)return {title:"AI 思考摘录",text:aiReasons[aiReasons.length-1].label+": "+aiReasons[aiReasons.length-1].reason};
    return {title:"本局观察",text:mode==="human"?"真人亲自下场,这张卡记录了你和 if-else 擂主的一次硬碰硬。":"本局没有可摘录的 AI 理由,但棋盘已经说明问题。"};
  }
  function buildShareText(){
    var title=(lastOutcome&&lastOutcome.title)||cardTitle("draw"),reason=bestReasonText();
    return title+"\n\n我在三模实测 AI 擂台跑了一局五子棋:共 "+moves.length+" 手,难度 "+difficultyLabel()+",AI 犯规 "+foulEvents.length+" 次。\n\n"+reason.title+": "+reason.text+"\n\n来挑战: https://sanmoshice.com/arena/";
  }
  async function copyShareText(){
    lastShareText=lastShareText||buildShareText();
    try{await navigator.clipboard.writeText(lastShareText);statusEl.textContent="分享文案已复制,去小红书/朋友圈贴战报吧";}
    catch(e){
      var ta=document.createElement("textarea");ta.value=lastShareText;document.body.appendChild(ta);ta.select();document["exec"+"Command"]("copy");ta.remove();statusEl.textContent="分享文案已复制";
    }
  }

  // ===== 模式切换 / 事件 =====
  function setMode(m){
    if(busy)stopGame();
    mode=m;
    document.querySelectorAll(".ar-tab").forEach(function(t){t.classList.toggle("on",t.dataset.mode===m)});
    $("#cfg").style.display=m==="human"?"none":"block";
    $("#cfgB").style.display=m==="watch"?"block":"none";
    $("#cfgA-title").textContent=m==="watch"?"黑方 AI":"挑战方 AI(执黑)";
    $("#btn-start").textContent=m==="human"?"重新开局":"开始对局";
    beginGame();
    reset();
    setRunningControls(false);syncDifficultyUI();updateUndoButton();
    statusEl.textContent=m==="human"?"你执黑先行,点击棋盘落子":(MOCK_MODE?"模拟模式已开启,点开始或等自动开局":"填好配置,点「开始对局」");
  }
  function setMockMode(on){
    MOCK_MODE=!!on;updateProviderBlock($("#cfgA"),true);updateProviderBlock($("#cfgB"),true);
  }
  function startMockGame(){
    setMockMode(true);
    setMode("byok");
    var cfg=$("#cfgA");
    cfg.querySelector(".ai-provider").value="openrouter";
    updateProviderBlock(cfg,false);
    cfg.querySelector(".ai-model").value="mock-demo-model";
    cfg.querySelector(".ai-key").value="";
    statusEl.textContent="模拟 AI 已入场:不用 key,先看它如何一本正经犯错";
    setTimeout(function(){if(mode==="byok"&&!busy)runByok();},80);
  }
  $("#mode-tabs").addEventListener("click",function(e){
    var b=e.target.closest(".ar-tab");if(b){setMockMode(false);setMode(b.dataset.mode);}
  });
  $("#btn-start").addEventListener("click",function(){
    if(mode==="human"){beginGame();reset();setRunningControls(false);statusEl.textContent="你执黑先行,点击棋盘落子";}
    else if(mode==="byok")runByok();
    else runWatch();
  });
  $("#btn-stop").addEventListener("click",stopGame);
  $("#btn-undo").addEventListener("click",undoHumanPair);
  $("#btn-card").addEventListener("click",drawCard);
  $("#btn-copy").addEventListener("click",copyShareText);
  $("#btn-mock").addEventListener("click",startMockGame);
  boardEl.addEventListener("click",onBoardClick);

  buildBoard();wireProviderUI();wireDifficultyUI();restoreKeys();updateProviderBlock($("#cfgA"),true);updateProviderBlock($("#cfgB"),true);setMode("human");
  })();
  </script>

  <style is:global>
