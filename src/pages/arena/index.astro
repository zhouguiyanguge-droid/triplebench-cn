---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="AI 擂台 · 五子棋 - 三模实测"
  description="带上你自己的 AI 来打擂:Claude、Gemini 直连对战我们的规则引擎擂主。你的大模型,打得过一段 if-else 吗?亲自下也行。"
>
  <main class="article tb-arena">
    <p class="eyebrow tb-badge">AI 擂台 · 第 1 关 · 五子棋</p>
    <h1>你的 AI,打得过一段 if-else 吗?</h1>
    <p class="lede">
      擂主是我们手写的<strong>规则引擎</strong>——没有大模型、不花一分钱、每步算得明明白白。
      你可以亲自上,也可以把你自己的 Claude / Gemini 带来代打。大模型下棋的真实水平,一试便知。
    </p>

    <div class="ar-strip">
      <div class="ar-rec"><span>擂主战绩(你这台设备)</span><b id="rec-text">0 胜 · 0 负 · 0 平</b></div>
      <div class="ar-modebar">
        <div class="ar-modes" id="mode-tabs">
          <button class="ar-tab on" data-mode="human">我亲自下</button>
          <button class="ar-tab" data-mode="byok">我的 AI 代打</button>
          <button class="ar-tab" data-mode="watch">AI 大战 AI</button>
        </div>
        <button id="btn-mock" class="ar-btn ar-btn-mock" type="button">先看一局模拟对局(不要 key)</button>
      </div>
    </div>

    <div class="ar-wrap">
      <div class="ar-left">
        <div id="board" class="ar-board" aria-label="五子棋棋盘"></div>
        <div class="ar-under">
          <span id="status" class="ar-status">你执黑先行,点击棋盘落子</span>
          <span class="ar-btns">
            <button id="btn-start" class="ar-btn ar-btn-main">开始对局</button>
            <button id="btn-stop" class="ar-btn" disabled>停止</button>
            <button id="btn-undo" class="ar-btn" disabled>悔棋</button>
            <button id="btn-card" class="ar-btn" disabled>生成战报卡</button>
            <button id="btn-copy" class="ar-btn" disabled>复制分享文案</button>
          </span>
        </div>
        <div id="difficulty-row" class="ar-difficulty">
          <span>擂主难度</span>
          <label><input type="radio" name="arena-difficulty" value="casual" /> 休闲</label>
          <label><input type="radio" name="arena-difficulty" value="standard" checked /> 标准</label>
          <label><input type="radio" name="arena-difficulty" value="hardcore" /> 硬核 benchmark</label>
          <em id="difficulty-note"></em>
        </div>
      </div>

      <div class="ar-right">
        <div id="cfg" class="ar-cfg">
          <div class="ar-cfg-block" id="cfgA">
            <h4 id="cfgA-title">挑战方 AI(执黑)</h4>
            <label>服务商
              <select class="ai-provider">
                <option value="anthropic">Anthropic(Claude)</option>
                <option value="gemini">Google(Gemini)</option>
                <option value="openrouter">OpenRouter</option>
                <option value="custom-openai">自定义(OpenAI 兼容)</option>
              </select>
            </label>
            <label>模型 <input class="ai-model" type="text" value="claude-haiku-4-5" /></label>
            <label class="ai-base-wrap" style="display:none">Base URL <input class="ai-base" type="url" placeholder="https://api.deepseek.com" autocomplete="off" /></label>
            <label>API Key <input class="ai-key" type="password" placeholder="sk-ant-..." autocomplete="off" /></label>
            <p class="ar-provider-help"></p>
          </div>
          <div class="ar-cfg-block" id="cfgB" style="display:none">
            <h4>白方 AI</h4>
            <label>服务商
              <select class="ai-provider">
                <option value="gemini">Google(Gemini)</option>
                <option value="anthropic">Anthropic(Claude)</option>
                <option value="openrouter">OpenRouter</option>
                <option value="custom-openai">自定义(OpenAI 兼容)</option>
              </select>
            </label>
            <label>模型 <input class="ai-model" type="text" value="gemini-2.5-flash" /></label>
            <label class="ai-base-wrap" style="display:none">Base URL <input class="ai-base" type="url" placeholder="https://api.deepseek.com" autocomplete="off" /></label>
            <label>API Key <input class="ai-key" type="password" placeholder="AIza..." autocomplete="off" /></label>
            <p class="ar-provider-help"></p>
          </div>
          <p class="ar-safe">🆓 <strong>没有 key?</strong>Gemini 的 key 可以白嫖:打开 <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">Google AI Studio</a> → Get API key,一分钟搞定,免费额度足够玩几十局。Anthropic 的 key 在 <a href="https://console.anthropic.com/" target="_blank" rel="noopener">console.anthropic.com</a> 创建(需开通 API 充值)。OpenRouter 在 <a href="https://openrouter.ai/keys" target="_blank" rel="noopener">openrouter.ai/keys</a> 建 key,Hermes / DeepSeek / Qwen / GLM / Llama 等几百个模型都在这,一个 key 全解锁。注意:ChatGPT / Claude 的网页订阅账号≠API key,接不进来。</p>
          <p class="ar-safe">🧾 <strong>可审计:</strong>本页代码完全开源,可自行审计: <a href="https://github.com/zhouguiyanguge-droid/triplebench-cn/tree/main/src/pages/arena" target="_blank" rel="noopener">github.com/zhouguiyanguge-droid/triplebench-cn/src/pages/arena</a></p>
          <p class="ar-safe">🇨🇳 国内模型优先走 OpenRouter;如果厂商提供 OpenAI 兼容接口,也可以选「自定义」填 Base URL。若浏览器直连被 CORS 拦住,同款模型换 OpenRouter 最稳。</p>
          <p class="ar-safe">🔒 Key 只保存在<strong>你自己的浏览器</strong>(localStorage),对局时由你的浏览器<strong>直连官方 API</strong>,不经过本站服务器——本站是纯静态页,想收也收不到。建议用单独的低额度 key。调用费用由 key 所有者承担,一局约几分钱。</p>
        </div>
        <div class="ar-logbox">
          <h4>对局记录 / AI 思考</h4>
          <div id="log" class="ar-log"><p class="ar-log-empty">还没有对局。选个模式,开打。</p></div>
        </div>
      </div>
    </div>

    <section class="ar-faq">
      <h2>这个擂台是怎么回事</h2>
      <p><strong>擂主不是 AI,是算法。</strong>一段约三百行的 JavaScript:扫描棋型、算分、看两步。它不思考、不犹豫、不收订阅费。本擂台采用<strong>自由规则五子棋</strong>:不设禁手,黑白双方只要在横、竖、斜任一方向形成连续五子或五子以上(长连),均立即判胜。而大语言模型下棋是出了名的菜——它是语言模型,不是搜索引擎,这是结构性弱点,不是调参能救的。所以这个擂台真正测的是:<strong>你为之付费的"智能",在规则明确的小世界里值多少。</strong></p>
      <p>AI 代打模式下,落子全自动:我们的页面把棋盘喂给你的模型、要求它返回坐标和理由,理由会显示在右侧。模型若给出非法坐标,默认有三次机会,每次重试都会附带当前合法空位提示;仍失败按犯规处理(由系统代走最优一步并记录)。</p>
      <p>战绩目前记在你本地浏览器。全球擂主战绩榜、真人房间、斗地主、以及「博主自己的 Claude Code 亲自守擂」——按计划逐步上。想催更或挑战规则,来 <a href="https://github.com/zhouguiyanguge-droid/triplebench-cn">GitHub</a> 提 issue。</p>
    </section>
  </main>

  <canvas id="cardCanvas" width="1080" height="1440" style="display:none"></canvas>

  <script is:inline>
  (function(){
  "use strict";
  // ===== ArenaEngine START =====
  var ArenaEngine=(function(){
    var SIZE=15, EMPTY=0, BLACK=1, WHITE=2;
    function idx(r,c){return r*SIZE+c}
    function rc(j){return [(j/SIZE)|0,j%SIZE]}
    function inBounds(r,c){return r>=0&&r<SIZE&&c>=0&&c<SIZE}
    function emptyBoard(){return new Array(SIZE*SIZE).fill(EMPTY)}
    function legalMoves(b){
      var out=[];
      for(var i=0;i<SIZE*SIZE;i++)if(b[i]===EMPTY)out.push(i);
      return out;
    }
    function isFull(b){return legalMoves(b).length===0}
    function checkWin(b,r,c,who){
      var dirs=[[0,1],[1,0],[1,1],[1,-1]];
      for(var d=0;d<dirs.length;d++){
        var n=1,dr=dirs[d][0],dc=dirs[d][1],s,rr,cc;
        for(s=1;s<SIZE;s++){rr=r+dr*s;cc=c+dc*s;if(!inBounds(rr,cc)||b[idx(rr,cc)]!==who)break;n++;}
        for(s=1;s<SIZE;s++){rr=r-dr*s;cc=c-dc*s;if(!inBounds(rr,cc)||b[idx(rr,cc)]!==who)break;n++;}
        if(n>=5)return true;
      }
      return false;
    }
    function lineInfo(b,r,c,dr,dc,who){
      var n=1,openA=0,openB=0,rr=r+dr,cc=c+dc;
      while(inBounds(rr,cc)&&b[idx(rr,cc)]===who){n++;rr+=dr;cc+=dc;}
      if(inBounds(rr,cc)&&b[idx(rr,cc)]===EMPTY)openA=1;
      rr=r-dr;cc=c-dc;
      while(inBounds(rr,cc)&&b[idx(rr,cc)]===who){n++;rr-=dr;cc-=dc;}
      if(inBounds(rr,cc)&&b[idx(rr,cc)]===EMPTY)openB=1;
      return [n,openA+openB];
    }
    function placeScore(b,r,c,who){
      if(!inBounds(r,c)||b[idx(r,c)]!==EMPTY)return -1;
      var dirs=[[0,1],[1,0],[1,1],[1,-1]],total=0,bigThreats=0;
      for(var d=0;d<dirs.length;d++){
        var li=lineInfo(b,r,c,dirs[d][0],dirs[d][1],who),n=li[0],open=li[1],s=0;
        if(n>=5)s=10000000;
        else if(n===4)s=open===2?1000000:(open===1?120000:0);
        else if(n===3)s=open===2?60000:(open===1?6000:0);
        else if(n===2)s=open===2?1200:(open===1?150:0);
        else s=open===2?60:10;
        if(s>=60000)bigThreats++;
        total+=s;
      }
      if(bigThreats>=2)total+=300000;
      return total;
    }
    function candidates(b,cap){
      var has=false,set=[],seen=new Array(SIZE*SIZE).fill(false),i,r0,c0,dr,dc,r,c,j;
      for(i=0;i<SIZE*SIZE;i++)if(b[i]!==EMPTY){
        has=true;r0=(i/SIZE)|0;c0=i%SIZE;
        for(dr=-2;dr<=2;dr++)for(dc=-2;dc<=2;dc++){
          r=r0+dr;c=c0+dc;
          if(!inBounds(r,c))continue;
          j=idx(r,c);
          if(b[j]===EMPTY&&!seen[j]){seen[j]=true;set.push(j);}
        }
      }
      if(!has)return [idx(7,7)];
      set.sort(function(x,y){
        var rx=(x/SIZE)|0,cx=x%SIZE,ry=(y/SIZE)|0,cy=y%SIZE;
        return (placeScore(b,ry,cy,WHITE)+placeScore(b,ry,cy,BLACK))-(placeScore(b,rx,cx,WHITE)+placeScore(b,rx,cx,BLACK));
      });
      return typeof cap==="number"?set.slice(0,cap):set;
    }
    function immediateWinsAfter(b,who,cap){
      var cand=candidates(b,cap||24),wins=[],k,j,r,c;
      for(k=0;k<cand.length;k++){
        j=cand[k];r=(j/SIZE)|0;c=j%SIZE;
        if(placeScore(b,r,c,who)>=10000000)wins.push(j);
      }
      return wins;
    }
    function bestMoveFor(b,who){
      var opp=who===BLACK?WHITE:BLACK,cand=candidates(b,18),best=-1,bestS=-Infinity,k,j,r,c,myS,cand2,m,j4,r4,c4,s2,reply,total,threats;
      if(cand.length===0)return -1;
      for(k=0;k<cand.length;k++){j=cand[k];r=(j/SIZE)|0;c=j%SIZE;if(placeScore(b,r,c,who)>=10000000)return j;}
      for(k=0;k<cand.length;k++){j=cand[k];r=(j/SIZE)|0;c=j%SIZE;if(placeScore(b,r,c,opp)>=10000000)return j;}
      for(k=0;k<cand.length;k++){
        j=cand[k];r=(j/SIZE)|0;c=j%SIZE;
        myS=placeScore(b,r,c,who)+0.92*placeScore(b,r,c,opp);
        b[j]=who;
        threats=immediateWinsAfter(b,who,18).length;
        reply=0;cand2=candidates(b,10);
        for(m=0;m<cand2.length;m++){
          j4=cand2[m];r4=(j4/SIZE)|0;c4=j4%SIZE;
          s2=placeScore(b,r4,c4,opp)+0.9*placeScore(b,r4,c4,who);
          if(s2>reply)reply=s2;
        }
        b[j]=EMPTY;
        total=myS-0.55*reply+(threats>=2?650000:0);
        if(total>bestS){bestS=total;best=j;}
      }
      return best;
    }
    function legalHint(b,limit){
      return candidates(b,limit||16).map(function(j){var p=rc(j);return (p[0]+1)+"行"+(p[1]+1)+"列";}).join("、");
    }
    return {
      SIZE:SIZE,EMPTY:EMPTY,BLACK:BLACK,WHITE:WHITE,idx:idx,rc:rc,inBounds:inBounds,emptyBoard:emptyBoard,
      legalMoves:legalMoves,isFull:isFull,checkWin:checkWin,lineInfo:lineInfo,placeScore:placeScore,
      candidates:candidates,immediateWinsAfter:immediateWinsAfter,bestMoveFor:bestMoveFor,legalHint:legalHint
    };
  })();
  // ===== ArenaEngine END =====

  // ===== 基础 =====
  var SIZE=ArenaEngine.SIZE, EMPTY=ArenaEngine.EMPTY, BLACK=ArenaEngine.BLACK, WHITE=ArenaEngine.WHITE;
  var API_TIMEOUT_MS=30000, FOUL_LIMIT=3, FOUL_POLICY="system_move"; // 可改为 "loss": LLM 犯规即判负
  var MOCK_MODE=new URLSearchParams(location.search).get("mock")==="1";
  var DIFFICULTIES={
    casual:{label:"休闲",candidateCap:10,replyCap:0,replyWeight:0},
    standard:{label:"标准",candidateCap:14,replyCap:6,replyWeight:0.35},
    hardcore:{label:"硬核 benchmark",candidateCap:null,replyCap:null,replyWeight:null}
  };
  var PROVIDERS={
    anthropic:{protocol:"anthropic",model:"claude-haiku-4-5",keyPlaceholder:"sk-ant-...",help:'Anthropic Console 创建 API key;浏览器直连需要官方 CORS 许可头。'},
    gemini:{protocol:"gemini",model:"gemini-2.5-flash",keyPlaceholder:"AIza...",help:'Google AI Studio 创建 API key,免费额度适合试打。'},
    openrouter:{protocol:"openai-compatible",model:"deepseek/deepseek-chat",keyPlaceholder:"sk-or-...",baseURL:"https://openrouter.ai/api/v1",help:'OpenRouter: Hermes / DeepSeek / Qwen / GLM / Llama 等几百个模型都在这,一个 key 全解锁。'},
    "custom-openai":{protocol:"openai-compatible",model:"deepseek-chat",keyPlaceholder:"sk-...",baseURL:"https://api.deepseek.com",customBase:true,help:'自定义 OpenAI 兼容接口:填厂商 Base URL,页面会调用 {baseURL}/chat/completions。若 CORS 失败,换 OpenRouter 接入同款模型最稳。'}
  };
  var board, moves, over, busy=false, abortFlag=false, mode="human", gameId=0, activeAbort=null;
  var difficulty=localStorage.getItem("ar_difficulty")||"standard";
  if(!DIFFICULTIES[difficulty])difficulty="standard";
  var aiReasons=[],foulEvents=[],lastOutcome=null,lastShareText="";
  var $=function(s){return document.querySelector(s)};
  var boardEl=$("#board"), statusEl=$("#status"), logEl=$("#log");
  var rec=loadRec();
  function loadRec(){
    var empty={casual:{w:0,l:0,d:0},standard:{w:0,l:0,d:0},hardcore:{w:0,l:0,d:0}};
    try{
      var old=JSON.parse(localStorage.getItem("ar_rec")||"null");
      if(old&&old.byDifficulty){
        Object.keys(empty).forEach(function(k){if(old.byDifficulty[k])empty[k]=old.byDifficulty[k];});
        return {byDifficulty:empty};
      }
      if(old&&typeof old.w==="number")empty.standard={w:old.w||0,l:old.l||0,d:old.d||0};
    }catch(e){}
    return {byDifficulty:empty};
  }
  function recBucket(){return rec.byDifficulty[effectiveDifficulty()]||rec.byDifficulty.standard;}
  function saveRec(){
    localStorage.setItem("ar_rec",JSON.stringify(rec));
    var b=recBucket(),label=DIFFICULTIES[effectiveDifficulty()].label;
    $("#rec-text").textContent=label+" · "+b.w+" 胜 · "+b.l+" 负 · "+b.d+" 平";
  }
  saveRec();

  // ===== 棋盘 UI =====
  var cells=[];
  function buildBoard(){
    boardEl.innerHTML="";cells=[];
    for(var r=0;r<SIZE;r++)for(var c=0;c<SIZE;c++){
      var d=document.createElement("button");
      d.className="ar-cell";d.dataset.r=r;d.dataset.c=c;
      boardEl.appendChild(d);cells.push(d);
    }
  }
  function render(lastIdx){
    for(var i=0;i<225;i++){
      var v=board[i];cells[i].className="ar-cell"+(v===BLACK?" s-b":v===WHITE?" s-w":"")+(i===lastIdx?" s-last":"");
    }
  }
  function reset(){
    board=ArenaEngine.emptyBoard();moves=[];over=false;abortFlag=false;
    aiReasons=[];foulEvents=[];lastOutcome=null;lastShareText="";
    render(-1);logEl.innerHTML='<p class="ar-log-empty">棋盘已就绪。</p>';
    $("#btn-card").disabled=true;$("#btn-copy").disabled=true;updateUndoButton();
  }

  // ===== ArenaDifficulty START =====
  var ArenaDifficulty=(function(){
  function bestMoveFor(E,b,who,level){
    if(level==="hardcore")return E.bestMoveFor(b,who);
    var d=(level==="casual")?{candidateCap:10,replyCap:0,replyWeight:0}:{candidateCap:14,replyCap:6,replyWeight:0.35};
    var SIZE=E.SIZE,BLACK=E.BLACK,WHITE=E.WHITE,opp=who===BLACK?WHITE:BLACK,cand=E.candidates(b,d.candidateCap),best=-1,bestS=-Infinity,k,j,r,c,myS,reply,cand2,m,j2,r2,c2,s2,total;
    if(cand.length===0)return -1;
    for(k=0;k<cand.length;k++){j=cand[k];r=(j/SIZE)|0;c=j%SIZE;if(E.placeScore(b,r,c,who)>=10000000)return j;}
    for(k=0;k<cand.length;k++){j=cand[k];r=(j/SIZE)|0;c=j%SIZE;if(E.placeScore(b,r,c,opp)>=10000000)return j;}
    for(k=0;k<cand.length;k++){
      j=cand[k];r=(j/SIZE)|0;c=j%SIZE;
      myS=E.placeScore(b,r,c,who)+0.75*E.placeScore(b,r,c,opp);
      reply=0;
      if(d.replyCap){
        b[j]=who;cand2=E.candidates(b,d.replyCap);
        for(m=0;m<cand2.length;m++){j2=cand2[m];r2=(j2/SIZE)|0;c2=j2%SIZE;s2=E.placeScore(b,r2,c2,opp)+0.8*E.placeScore(b,r2,c2,who);if(s2>reply)reply=s2;}
        b[j]=E.EMPTY;
      }
      total=myS-d.replyWeight*reply;
      if(total>bestS){bestS=total;best=j;}
    }
    return best;
  }
  return {bestMoveFor:bestMoveFor};
  })();
  // ===== ArenaDifficulty END =====

  // ===== 胜负 =====
  function idx(r,c){return ArenaEngine.idx(r,c)}
  function win(b,r,c,who){return ArenaEngine.checkWin(b,r,c,who)}
  function bestMoveFor(b,who){return ArenaEngine.bestMoveFor(b,who)}
  function effectiveDifficulty(){return mode==="human"?difficulty:"hardcore"}
  function difficultyLabel(){return DIFFICULTIES[effectiveDifficulty()].label}
  function bestMoveForCurrent(b,who){
    return ArenaDifficulty.bestMoveFor(ArenaEngine,b,who,effectiveDifficulty());
  }

  // ===== 日志 =====
  function log(html,cls){
    var first=logEl.querySelector(".ar-log-empty");if(first)first.remove();
    var p=document.createElement("div");p.className="ar-log-item"+(cls?" "+cls:"");p.innerHTML=html;
    logEl.prepend(p);
  }
  function coordName(j){return "("+(((j/15)|0)+1)+"行"+(j%15+1)+"列)"}

  // ===== 落子与回合 =====
  function place(j,who){
    if(over||j<0||j>=225||board[j]!==EMPTY)return false;
    board[j]=who;moves.push({j:j,who:who});render(j);
    var r=(j/15)|0,c=j%15;
    if(win(board,r,c,who)){endGame(who);return true;}
    if(moves.length===225){endGame(0);return true;}
    updateUndoButton();
    return false;
  }
  function endGame(who){
    over=true;busy=false;abortFlag=false;
    $("#btn-stop").disabled=true;$("#btn-start").disabled=false;$("#btn-card").disabled=false;$("#btn-copy").disabled=false;updateUndoButton();
    var msg,bucket=recBucket(),result=who===0?"draw":(who===BLACK?"challenger":"host");
    if(who===0){msg="平局! 这局像一份没有结论但很诚实的实验记录。生成战报卡,留个样本。";bucket.d++;}
    else if(mode==="watch"){msg=(who===BLACK?"黑方 AI":"白方 AI")+" 获胜! 两个模型互啄,至少有一个活着走出了 JSON。";}
    else if(who===WHITE){
      msg=randomLoseMessage();
      bucket.w++;
    }else{
      msg=randomWinMessage();
      bucket.l++;
    }
    lastOutcome={winner:who,result:result,mode:mode,difficulty:effectiveDifficulty(),title:cardTitle(result),summary:msg};
    lastShareText=buildShareText();
    if(mode!=="watch")saveRec();
    statusEl.textContent=msg;log("<b>"+msg+"</b> 共 "+moves.length+" 手","ar-li-end");
  }
  function randomLoseMessage(){
    var arr=[
      "你刚亲手完成了一次 LLM 结构性弱点实测:大模型不是搜索引擎,规则小世界里它就是弟弟。这是你的实验报告 → 生成战报卡",
