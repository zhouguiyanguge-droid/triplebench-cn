    var modelEl=el.querySelector(".ai-model"),keyEl=el.querySelector(".ai-key"),baseWrap=el.querySelector(".ai-base-wrap"),baseEl=el.querySelector(".ai-base"),helpEl=el.querySelector(".ar-provider-help");
