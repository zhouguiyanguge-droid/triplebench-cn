  // ===== LLM 接入 =====
  function boardText(){
    var head="   ",r,c;
    for(c=0;c<15;c++)head+=(c+1<10?" ":"")+(c+1)+" ";
    var out=[head];
    for(r=0;r<15;r++){var line=(r+1<10?" ":"")+(r+1)+" ";
      for(c=0;c<15;c++){var v=board[idx(r,c)];line+=" "+(v===BLACK?"X":v===WHITE?"O":".")+" ";}
      out.push(line);}
    return out.join("\n");
  }
  function buildPrompt(who){
    var me=who===BLACK?"X(黑)":"O(白)", last=moves.length?coordName(moves[moves.length-1].j):"无";
    return "你在下五子棋,15x15 棋盘,行列编号都从 1 到 15。X 是黑,O 是白,. 是空位。五连即胜。\n"+
      "规则:自由规则五子棋,无禁手;连续五子或五子以上(长连)都算胜利。\n"+
      "你执 "+me+"。对方刚落子: "+last+"。当前棋盘:\n\n"+boardText()+"\n\n"+
      "请选择你的下一步。优先:能成五连先成五连;对方将成五连必须堵。\n"+
      '只返回一行 JSON,格式 {"row":行号,"col":列号,"reason":"不超过30字的理由"} ,行列号用 1 到 15,必须是空位,禁止其他文字。';
  }
  function retryPrompt(prompt,lastErr){
    return prompt+"\n\n注意:你上次的回答无效("+lastErr+"),请重新选一个合法空位。当前推荐合法空位示例: "+ArenaEngine.legalHint(board,18)+"。仍然只返回一个 JSON。";
  }
  async function fetchWithTimeout(url,options,signal,provider){
    var ctl=new AbortController(),timer=setTimeout(function(){ctl.abort();},API_TIMEOUT_MS),onAbort=function(){ctl.abort();};
    if(signal)signal.addEventListener("abort",onAbort,{once:true});
    try{
      var opts={};for(var k in options)opts[k]=options[k];
      opts.signal=ctl.signal;
      return await fetch(url,opts);
    }catch(e){
      if(signal&&signal.aborted)throw new Error("__abort");
      if(ctl.signal.aborted)throw new Error("请求超时(30 秒),可以稍后重试");
      if(provider==="custom-openai")throw new Error("网络或 CORS 失败:该厂商可能不允许浏览器直连(CORS),换 OpenRouter 接入同款模型最稳");
      throw new Error("网络或 CORS 失败:浏览器直连官方 API 未连通,请检查网络、服务商是否允许浏览器直连");
    }finally{
      clearTimeout(timer);
      if(signal)signal.removeEventListener("abort",onAbort);
    }
  }
  async function apiFetch(provider,url,options,signal){
    for(var attempt=0;attempt<2;attempt++){
      var resp=await fetchWithTimeout(url,options,signal,provider);
      if(resp.status===429&&attempt===0){
        await sleep(900,signal);
        continue;
      }
      if(!resp.ok){
        var body=(await resp.text()).slice(0,220),prefix=providerName(provider),msg;
        if(resp.status===401||resp.status===403)msg=prefix+" key 无效或权限不足("+resp.status+"),请检查 API key / 账号额度 / 模型权限";
        else if(resp.status===429)msg=prefix+" 限流或额度用尽(429),已退避重试 1 次仍失败";
        else msg=prefix+" API 返回 "+resp.status+": "+body;
        throw new Error(msg);
      }
      return resp;
    }
    throw new Error("API 限流,已退避重试 1 次仍失败");
  }
  function providerName(provider){
    return provider==="anthropic"?"Anthropic":provider==="gemini"?"Gemini":provider==="openrouter"?"OpenRouter":"自定义接口";
  }
  async function callLLM(cfg,prompt,signal){
    if(MOCK_MODE)return mockLLM(prompt);
    if(cfg.provider==="anthropic"){
      var resp=await apiFetch("anthropic","https://api.anthropic.com/v1/messages",{method:"POST",headers:{
        "content-type":"application/json","x-api-key":cfg.key,
        "anthropic-version":"2023-06-01","anthropic-dangerous-direct-browser-access":"true"
      },body:JSON.stringify({model:cfg.model,max_tokens:240,messages:[{role:"user",content:prompt}]})},signal);
      var data=await resp.json();return data.content.map(function(b){return b.text||""}).join("");
    }else if(cfg.provider==="gemini"){
      var url="https://generativelanguage.googleapis.com/v1beta/models/"+encodeURIComponent(cfg.model)+":generateContent?key="+encodeURIComponent(cfg.key);
      var resp2=await apiFetch("gemini",url,{method:"POST",headers:{"content-type":"application/json"},
        body:JSON.stringify({contents:[{parts:[{text:prompt}]}],generationConfig:{maxOutputTokens:400}})},signal);
      var d2=await resp2.json();
      try{return d2.candidates[0].content.parts.map(function(p){return p.text||""}).join("");}
      catch(e){throw new Error("Gemini 返回为空(可能触发安全过滤)");}
    }
    var base=cfg.provider==="openrouter"?"https://openrouter.ai/api/v1":normalizeBaseURL(cfg.baseURL);
    var headers={"content-type":"application/json","Authorization":"Bearer "+cfg.key};
    if(cfg.provider==="openrouter"){
      headers["HTTP-Referer"]="https://sanmoshice.com";
      headers["X-Title"]="TripleBench Arena";
      headers["X-OpenRouter-Title"]="TripleBench Arena";
    }
    // TODO: 若国内厂商浏览器直连持续被 CORS 拦截,可考虑显式 opt-in 的 Pages Function 中转;本期不实现服务器中转。
    var resp3=await apiFetch(cfg.provider,base.replace(/\/+$/,"")+"/chat/completions",{method:"POST",headers:headers,
      body:JSON.stringify({model:cfg.model,messages:[{role:"user",content:prompt}],max_tokens:240,temperature:0.2})},signal);
    var d3=await resp3.json();
    try{return d3.choices[0].message.content||"";}
    catch(e2){throw new Error(providerName(cfg.provider)+" 返回为空或不符合 OpenAI chat completions 格式");}
  }
  function normalizeBaseURL(raw){
    var v=String(raw||"").trim();
    if(!v)throw new Error("请先填 Base URL");
    v=v.replace(/\/+$/,"");
    if(/\/chat\/completions$/.test(v))v=v.replace(/\/chat\/completions$/,"");
    if(!/^https?:\/\//i.test(v))throw new Error("Base URL 需要以 http:// 或 https:// 开头");
    return v;
  }
  function mockLLM(prompt){
    var hasRetry=prompt.indexOf("上次的回答无效")>=0;
    if(MOCK_MODE&&moves.length===0&&!hasRetry)return '```json\n{"row":99,"col":1,"reason":"mock 首步故意越界"}\n```';
    var who=prompt.indexOf("你执 O")>=0?WHITE:BLACK;
    var j=bestMoveFor(board,who);
    if(j<0)j=ArenaEngine.legalMoves(board)[0];
    var p=ArenaEngine.rc(j);
    return JSON.stringify({row:p[0]+1,col:p[1]+1,reason:hasRetry?"mock 重试后合法落子":"mock 合法落子"});
  }
  // ===== LLMTools START =====
  var LLMTools=(function(){
    function extractJsonObjects(text){
      var out=[],depth=0,start=-1,inStr=false,esc=false,i,ch;
      text=String(text||"");
      for(i=0;i<text.length;i++){
        ch=text[i];
        if(inStr){
          if(esc){esc=false;continue;}
          if(ch==="\\"){esc=true;continue;}
          if(ch==='"')inStr=false;
          continue;
        }
        if(ch==='"'){inStr=true;continue;}
        if(ch==="{"){if(depth===0)start=i;depth++;}
        else if(ch==="}"&&depth>0){depth--;if(depth===0&&start>=0){out.push(text.slice(start,i+1));start=-1;}}
      }
      return out;
    }
    function parseMoveText(text,opts){
      var chunks=extractJsonObjects(text),o,r,c;
      if(chunks.length===0)throw new Error("未找到 JSON");
      if(chunks.length>1)throw new Error("返回了多个 JSON 对象,只能返回一个");
      try{o=JSON.parse(chunks[0]);}catch(e){throw new Error("JSON 无法解析:"+e.message);}
      if(!o||typeof o!=="object"||Array.isArray(o))throw new Error("JSON 必须是对象");
      if(!Number.isInteger(o.row)||!Number.isInteger(o.col))throw new Error("row/col 必须是整数数字");
      r=o.row-1;c=o.col-1;
      if(r<0||r>=opts.size||c<0||c>=opts.size)throw new Error("坐标越界 row="+o.row+" col="+o.col);
      if(!opts.isEmpty(r,c))throw new Error("("+o.row+","+o.col+") 已有棋子");
      return {j:opts.toIndex(r,c),reason:String(o.reason||"").slice(0,60)};
    }
    return {extractJsonObjects:extractJsonObjects,parseMoveText:parseMoveText};
  })();
  // ===== LLMTools END =====
  function parseMove(text){
    return LLMTools.parseMoveText(text,{size:SIZE,isEmpty:function(r,c){return board[idx(r,c)]===EMPTY;},toIndex:idx});
  }
  async function llmTurn(cfg,who,label,myGame){
    var prompt=buildPrompt(who),lastErr="";
    for(var t=0;t<FOUL_LIMIT;t++){
      if(!isActive(myGame)||abortFlag)throw new Error("__abort");
      statusEl.textContent=label+" 思考中…"+(t?"(第"+(t+1)+"次尝试)":"");
      var text;
      try{text=await callLLM(cfg,lastErr?retryPrompt(prompt,lastErr):prompt,activeAbort&&activeAbort.signal);}
      catch(e){if(String(e.message).indexOf("__abort")>=0)throw e;throw new Error(label+" 调用失败:"+e.message);}
      if(!isActive(myGame))throw new Error("__abort");
      try{
        var mv=parseMove(text);
        if(mv.reason)aiReasons.push({label:label,reason:mv.reason,j:mv.j});
        log("<b>"+label+"</b> "+coordName(mv.j)+(mv.reason?'<br><span class="ar-reason">💭 '+escapeHtml(mv.reason)+"</span>":""));
        return {j:mv.j,forced:false,forfeit:false};
      }catch(pe){
        lastErr=pe.message;foulEvents.push({label:label,error:pe.message,tryNo:t+1});
        log(label+" 第 "+(t+1)+" 次提交非法坐标——一本正经地下出了不存在的棋("+escapeHtml(pe.message)+"),重试…","ar-li-warn");
      }
    }
    if(FOUL_POLICY==="loss"){
      log("<b>"+label+" 犯规 "+FOUL_LIMIT+" 次</b>,按配置判负。JSON 都没走明白,棋自然也下不明白。","ar-li-warn");
      return {j:-1,forced:false,forfeit:true};
    }
    var fb=bestMoveFor(board,who);
    log("<b>"+label+" 犯规 "+FOUL_LIMIT+" 次</b>,系统代走 "+coordName(fb)+"。这步不是 AI 灵光一现,是裁判把它从 JSON 泥坑里捞出来。","ar-li-warn");
    return {j:fb,forced:true,forfeit:false};
  }
  function escapeHtml(s){return s.replace(/[&<>"']/g,function(ch){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]})}

  // ===== 配置读取 =====
  function readCfg(blockSel){
    var el=$(blockSel);
    var cfg={provider:el.querySelector(".ai-provider").value,
             model:el.querySelector(".ai-model").value.trim(),
             key:el.querySelector(".ai-key").value.trim(),
             baseURL:(el.querySelector(".ai-base")&&el.querySelector(".ai-base").value.trim())||""};
    if(!cfg.key&&!MOCK_MODE)throw new Error("请先填 API Key");
    if(!cfg.model)throw new Error("请先填模型名");
    if(cfg.provider==="custom-openai")normalizeBaseURL(cfg.baseURL);
    return cfg;
  }
  function updateProviderBlock(el,keepModel){
