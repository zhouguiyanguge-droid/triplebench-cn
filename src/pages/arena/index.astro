  // ===== 对局主循环 =====
  function beginGame(){
    if(activeAbort)activeAbort.abort();
    activeAbort=new AbortController();
    gameId++;abortFlag=false;over=false;busy=false;
    return gameId;
  }
  function isActive(id){return id===gameId&&!abortFlag;}
  function stopGame(){
    if(activeAbort)activeAbort.abort();
    abortFlag=true;gameId++;busy=false;over=true;
    $("#btn-start").disabled=false;$("#btn-stop").disabled=true;$("#btn-card").disabled=true;
    statusEl.textContent="已停止,可重新开始";
